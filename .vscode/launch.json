    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9000
        },
        {
            "name": "Attach to Chrome",
            "port": 9222,
            "request": "attach",
            "type": "msedge",
            "urlFilter": "http://localhost/moodle/my",
            "webRoot": "${workspaceFolder}"
        },


        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost/moodle/my",
            "webRoot": "${workspaceFolder}"
        }
    ]
}